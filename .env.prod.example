# Production environment for docker-compose.prod.yml.
# Copy to .env.prod and fill in. NEVER commit .env.prod.
# EQUALISE_ENV=production makes the backend refuse to boot if any required
# secret below is empty.

EQUALISE_ENV=production

# --- Database (compose wires these together) ---
POSTGRES_USER=equalise
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=equalise
DATABASE_URL=postgresql+psycopg://equalise:CHANGE_ME_strong_password@db:5432/equalise

# --- Job queue ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- LLM providers ---
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Auth ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=1440

# --- Edge / TLS (Caddy) ---
DOMAIN=equalise.example.com
ACME_EMAIL=ops@example.com

# --- CORS: concrete allow-list, never * in production ---
CORS_ORIGINS=https://equalise.example.com

# --- Observability (optional) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Backups ---
BACKUP_RETENTION=14
# Optional off-site; requires aws creds in the backup container.
BACKUP_S3_BUCKET=
