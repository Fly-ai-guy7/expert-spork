# ── Expert Spork Configuration ────────────────────────────────────────
# Copy this file to .env and fill in your values.

SPORK_DEBUG=false
SPORK_HOST=0.0.0.0
SPORK_PORT=8000
SPORK_WORKERS=1

# Model
SPORK_MODEL_NAME=default
SPORK_MODEL_DEVICE=cpu
SPORK_MAX_BATCH_SIZE=32

# Logging
SPORK_LOG_LEVEL=INFO
SPORK_LOG_JSON=true
