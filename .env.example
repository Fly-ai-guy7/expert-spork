# ─── Database ────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/expertspork?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/expertspork?schema=public"

# ─── Auth (NextAuth.js v5) ────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-min-32-chars"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ─── Stripe ──────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── Cloudinary (media uploads) ──────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ─── OpenAI (AI matching + brief generation) ─────────────
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# ─── Algolia (search) ────────────────────────────────────
ALGOLIA_APP_ID="your-app-id"
ALGOLIA_ADMIN_API_KEY="your-admin-key"
NEXT_PUBLIC_ALGOLIA_APP_ID="your-app-id"
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY="your-search-key"
ALGOLIA_EXPERTS_INDEX="experts_production"
ALGOLIA_PROJECTS_INDEX="projects_production"

# ─── Resend (email) ──────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@expertspork.com"
RESEND_FROM_NAME="ExpertSpork"

# ─── Pusher (real-time) ──────────────────────────────────
PUSHER_APP_ID="your-app-id"
PUSHER_KEY="your-key"
PUSHER_SECRET="your-secret"
PUSHER_CLUSTER="us2"
NEXT_PUBLIC_PUSHER_KEY="your-key"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# ─── Monitoring & Analytics ──────────────────────────────
SENTRY_DSN="https://...@sentry.io/..."
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ─── App Config ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ExpertSpork"
PLATFORM_FEE_RATE_FREE=0.08
PLATFORM_FEE_RATE_PRO=0.05
