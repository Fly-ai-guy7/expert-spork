# --- Environment ---
# development | production
# In production the backend refuses to start with empty required secrets.
EQUALISE_ENV=development

# --- LLM providers ---
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- Database ---
DATABASE_URL=postgresql+psycopg://equalise:equalise@db:5432/equalise

# --- Auth (required in production) ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=1440

# --- Models ---
CLAUDE_OPUS_MODEL=claude-opus-4-7
CLAUDE_SONNET_MODEL=claude-sonnet-4-6
DEEPSEEK_MODEL=deepseek-chat

# --- Pipeline ---
DEFAULT_MAX_DEBATE_ROUNDS=3
HIL_GATING_ENABLED=true

# --- App ---
LOG_LEVEL=INFO
# Comma-separated allow-list. In production must not be empty or "*".
CORS_ORIGINS=http://localhost:5173

# --- Job queue ---
# Leave empty to run Celery in eager (in-process) mode — fine for local dev.
# Set to a Redis URL in production and run the worker container.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Security ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute

# --- Observability (optional) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Frontend ---
VITE_API_BASE=http://localhost:8000
