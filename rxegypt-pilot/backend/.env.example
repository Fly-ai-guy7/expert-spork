# RxEgypt backend environment — copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg2://user:pass@localhost/rxegypt
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Paymob (Egypt) — leave blank until live credentials are issued
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=

# Pharmacist WhatsApp line for Rx confirmation (E.164, e.g. +201001234567)
PHARMACIST_WHATSAPP=+20

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
