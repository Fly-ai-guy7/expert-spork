# Backend environment variables (FastAPI)

# Comma-separated list of additional allowed CORS origins (your deployed
# frontend URL goes here). Localhost dev origins and *.vercel.app are
# already allowed by default.
# Example:
# ALLOWED_ORIGINS=https://luxor-guest-house.vercel.app,https://www.luxorguesthouse.com
ALLOWED_ORIGINS=

# Optional: override where booking enquiries are stored.
# Defaults to <repo>/database/bookings.json
# BOOKINGS_FILE=/var/data/bookings.json
