<!doctype html>
<html lang="en" dir="ltr">
<head><meta charset="utf-8"/><title>Coaching Report</title></head>
<body class="ltr">

<div class="cover">
  <h1>Coaching Report</h1>
  <div class="meta">EQUALISE Egypt — Training Session</div>
  <h2 style="border:none;">Grade: {{ grade or "—" }} · {{ "%.0f"|format(total_score or 0) }}/100</h2>
</div>

<div class="disclaimer">{{ disclaimer_en }}</div>

<h2>Per-Round Performance</h2>
{% for r in per_round %}
<div class="argument-block">
  <div class="meta">Round {{ r.round_no }}</div>
  <div class="kv"><span class="k">Factual:</span> {{ "%.0f"|format(r.factual) }}</div>
  <div class="kv"><span class="k">Provable:</span> {{ "%.0f"|format(r.provable) }}</div>
  <div class="kv"><span class="k">Unbiased:</span> {{ "%.0f"|format(r.unbiased) }}</div>
  <div class="kv"><span class="k">Legal-law-based:</span> {{ "%.0f"|format(r.legal_law_based) }}</div>
  <div class="kv"><span class="k">Overall:</span> {{ "%.0f"|format(r.overall) }}</div>
  {% if r.rationale_en %}<p><em>{{ r.rationale_en }}</em></p>{% endif %}
</div>
{% endfor %}

<h2>Missed Statute Citations</h2>
<ul class="gaps">
  {% for c in missed_citations %}<li>{{ c }}</li>{% else %}<li><em>None — strong citation coverage.</em></li>{% endfor %}
</ul>

<h2>Evidence Gaps to Address</h2>
<ul class="gaps">
  {% for g in evidence_gaps_to_address %}<li>{{ g }}</li>{% else %}<li><em>None identified.</em></li>{% endfor %}
</ul>

<h2>Weak Patterns to Work On</h2>
<ul class="gaps">
  {% for w in weak_patterns %}<li>{{ w }}</li>{% else %}<li><em>None — consistent performance across dimensions.</em></li>{% endfor %}
</ul>

<div class="disclaimer">{{ disclaimer_en }}</div>

</body>
</html>
