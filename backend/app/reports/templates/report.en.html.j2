<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8"/>
<title>EQUALISE Egypt — Case Report</title>
</head>
<body class="ltr">

<div class="cover">
  <h1>EQUALISE™ EGYPT</h1>
  <div class="meta">AI Legal Simulation Report</div>
  <h2 style="border:none;">{{ case.title_en or case.title_ar or "Untitled Case" }}</h2>
  <div class="meta">Area of Law: {{ case.area_of_law or "—" }}</div>
  <div class="meta">Case ID: {{ case.id }}</div>
</div>

<div class="disclaimer">{{ disclaimer_en }}</div>

<h2>Case Summary</h2>
<p>{{ case.summary_en or "No summary available." }}</p>

<h3>Parties</h3>
<ul>
  {% for p in case.parties %}
  <li><span class="k">{{ p.role }}:</span> {{ p.name_en or p.name_ar or "—" }}</li>
  {% endfor %}
</ul>

<h2>Prosecution Arguments</h2>
{% for a in prosecution_arguments %}
<div class="argument-block">
  <div class="meta">Round {{ a.round_no }} · {{ a.llm_used or "—" }}
    {% if a.score_overall is not none %}<span class="score-pill">{{ "%.0f"|format(a.score_overall) }}/100</span>{% endif %}
  </div>
  <p>{{ a.content_en or a.content_ar }}</p>
</div>
{% else %}
<p><em>No prosecution arguments recorded.</em></p>
{% endfor %}

<h2>Defense Arguments</h2>
{% for a in defense_arguments %}
<div class="argument-block">
  <div class="meta">Round {{ a.round_no }} · {{ a.llm_used or "—" }}
    {% if a.score_overall is not none %}<span class="score-pill">{{ "%.0f"|format(a.score_overall) }}/100</span>{% endif %}
  </div>
  <p>{{ a.content_en or a.content_ar }}</p>
</div>
{% else %}
<p><em>No defense arguments recorded.</em></p>
{% endfor %}

{% if trainee_arguments %}
<h2>Trainee Arguments</h2>
{% for a in trainee_arguments %}
<div class="argument-block">
  <div class="meta">Round {{ a.round_no }} · Trainee
    {% if a.score_overall is not none %}<span class="score-pill">{{ "%.0f"|format(a.score_overall) }}/100</span>{% endif %}
  </div>
  <p>{{ a.content_en or a.content_ar }}</p>
</div>
{% endfor %}
{% endif %}

<h2>Judicial Assessment & Ruling</h2>
{% if ruling %}
<div class="kv"><span class="k">Plaintiff success probability:</span> {{ "%.0f"|format(ruling.plaintiff_success_prob or 0) }}%</div>
<div class="kv"><span class="k">Override applied:</span> {{ "Yes" if ruling.override_applied else "No" }}</div>
<p>{{ ruling.text_en or ruling.text_ar or "" }}</p>

<h3>Critical Evidence Gaps</h3>
<ul class="gaps">
  {% for gap in ruling.critical_evidence_gaps or [] %}
  <li>{{ gap }}</li>
  {% else %}
  <li><em>None identified.</em></li>
  {% endfor %}
</ul>

<h3>Precedent References</h3>
<ul class="gaps">
  {% for ref in ruling.precedent_refs or [] %}
  <li>{{ ref }}</li>
  {% else %}
  <li><em>None cited.</em></li>
  {% endfor %}
</ul>
{% else %}
<p><em>No ruling produced.</em></p>
{% endif %}

<h2>Projected Outcome</h2>
{% if outcome %}
<div class="outcome-box">
  <div class="kv"><span class="k">Projected probability:</span> {{ "%.0f"|format(outcome.projected_prob or 0) }}%</div>
  <div class="kv"><span class="k">Risk score:</span> {{ "%.0f"|format(outcome.risk_score or 0) }}/100</div>
  <div class="kv"><span class="k">Pretrial resolution:</span> {{ outcome.pretrial_resolution_en or "—" }}</div>
</div>
{% else %}
<p><em>No outcome produced.</em></p>
{% endif %}

<div class="disclaimer">{{ disclaimer_en }}</div>

</body>
</html>
