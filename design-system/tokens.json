      "anticipate": { "value": "cubic-bezier(0.36, 0, 0.66, -0.56)", "description": "Pull-back before action" }
    },
    "philosophy": {
      "principle1": "Micro-interactions confirm intent — every click has feedback within 100ms",
      "principle2": "Page transitions slide in from right, back from left (directional awareness)",
      "principle3": "Modals scale up from 95% opacity 0 to 100% opacity 1 (spring easing)",
      "principle4": "Loading states use skeleton shimmer, never spinners alone",
      "principle5": "Hover states are subtle lifts (translateY -1px) not color-only changes"
    }
  },

